rules_version = '2';

// Reglas de seguridad de Fulbo (multi-grupo)
//
// - Solo entran usuarios logueados con Google.
// - Cada grupo guarda en miembros_uids las cuentas con acceso; admin_uid es el admin.
// - El admin gestiona jugadores, niveles, partidos y solicitudes de su grupo.
// - Cada jugador puede editar solo su propio perfil (nombre, posición, foto),
//   confirmar su asistencia y votar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function logueado() {
      return request.auth != null;
    }

    function rutaGrupo(grupoId) {
      return /databases/$(database)/documents/grupos/$(grupoId);
    }

    function esMiembro(grupoId) {
      return logueado() && request.auth.uid in get(rutaGrupo(grupoId)).data.miembros_uids;
    }

    function esAdmin(grupoId) {
      return logueado() && get(rutaGrupo(grupoId)).data.admin_uid == request.auth.uid;
    }

    // Estado posterior a la escritura: permite crear el grupo y su contenido en un mismo batch
    function esAdminDespues(grupoId) {
      return logueado() && getAfter(rutaGrupo(grupoId)).data.admin_uid == request.auth.uid;
    }

    function jugador(jugadorId) {
      return get(/databases/$(database)/documents/jugadores/$(jugadorId)).data;
    }

    function esMiJugador(jugadorId) {
      return logueado() && jugador(jugadorId).uid_firebase == request.auth.uid;
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function mantieneGrupo() {
      return request.resource.data.grupo_id == resource.data.grupo_id;
    }

    function partidoDe(partidoId) {
      return get(/databases/$(database)/documents/partidos/$(partidoId)).data;
    }

    function participacionDe(participacionId) {
      return get(/databases/$(database)/documents/participaciones/$(participacionId)).data;
    }

    function rutaVotoMvp(partidoId, jugadorId) {
      return /databases/$(database)/documents/votos_mvp/$(partidoId + '_' + jugadorId);
    }

    // Asistió: lo marca el admin al cerrar el partido.
    // Misma condición que asistioAlPartido() en src/utils/mvp.js
    function asistio(p) {
      return p.get('asistio', false) == true;
    }

    function jugoElPartido(participacionId, jugadorId, partidoId) {
      let p = participacionDe(participacionId);
      return p.jugador_id == jugadorId && p.partido_id == partidoId && asistio(p);
    }

    // La foto de perfil se guarda comprimida dentro del jugador (data URL JPEG)
    function fotoValida() {
      return !('foto_url' in request.resource.data)
        || request.resource.data.foto_url == null
        || (request.resource.data.foto_url is string
            && request.resource.data.foto_url.size() < 120000);
    }

    // ─── Grupos ─────────────────────────────────────────────────────────────

    match /grupos/{grupoId} {
      allow get, list: if logueado() && request.auth.uid in resource.data.miembros_uids;

      allow create: if logueado()
        && request.resource.data.admin_uid == request.auth.uid
        && request.resource.data.miembros_uids == [request.auth.uid]
        && getAfter(/databases/$(database)/documents/codigos_invitacion/$(request.resource.data.codigo_invitacion)).data.grupo_id == grupoId;

      // El admin edita el grupo (sin transferir la administración ni cambiar el código)
      allow update: if logueado()
        && resource.data.admin_uid == request.auth.uid
        && request.resource.data.admin_uid == resource.data.admin_uid
        && request.resource.data.codigo_invitacion == resource.data.codigo_invitacion;

      // Ingreso con código: el usuario solo puede agregarse a sí mismo, y en el mismo
      // batch tiene que dejar una solicitud con el código correcto
      allow update: if logueado()
        && soloCambia(['miembros_uids'])
        && request.resource.data.miembros_uids.toSet()
             == resource.data.miembros_uids.toSet().union([request.auth.uid].toSet())
        && getAfter(/databases/$(database)/documents/grupos/$(grupoId)/solicitudes/$(request.auth.uid)).data.codigo
             == resource.data.codigo_invitacion;

      allow delete: if false;

      // Pedidos de ingreso de cuentas aún no vinculadas a un jugador
      match /solicitudes/{solicitudUid} {
        allow get: if logueado() && (solicitudUid == request.auth.uid || esAdmin(grupoId));
        allow list: if esAdmin(grupoId);

        allow create, update: if logueado()
          && solicitudUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.codigo == get(rutaGrupo(grupoId)).data.codigo_invitacion
          && (resource == null || resource.data.estado == 'pendiente');

        allow update, delete: if esAdmin(grupoId);
      }
    }

    // Permite buscar un grupo por código sin poder listar todos los códigos
    match /codigos_invitacion/{codigo} {
      allow get: if logueado();
      allow list: if false;
      // Si el código ya existe esto sería un update y se rechaza: garantiza códigos únicos
      allow create: if esAdminDespues(request.resource.data.grupo_id)
        && getAfter(rutaGrupo(request.resource.data.grupo_id)).data.codigo_invitacion == codigo;
      allow update, delete: if false;
    }

    // ─── Jugadores ──────────────────────────────────────────────────────────

    match /jugadores/{jugadorId} {
      allow read: if logueado()
        && (resource.data.uid_firebase == request.auth.uid || esMiembro(resource.data.grupo_id));

      allow create: if esAdminDespues(request.resource.data.grupo_id) && fotoValida();

      // Admin: todo, menos mover el jugador a otro grupo
      allow update: if esAdmin(resource.data.grupo_id) && mantieneGrupo() && fotoValida();

      // Jugador: solo su propio perfil y sin tocar nivel, estado, vinculación ni estadísticas
      allow update: if logueado()
        && resource.data.uid_firebase == request.auth.uid
        && soloCambia(['nombre', 'posicion_preferida', 'foto_url', 'club'])
        && fotoValida();

      allow delete: if esAdmin(resource.data.grupo_id);
    }

    match /miembros_grupo/{miembroId} {
      allow read: if esMiembro(resource.data.grupo_id);

      // El id es {grupoId}_{jugadorId}
      allow create: if esAdminDespues(request.resource.data.grupo_id)
        && miembroId == request.resource.data.grupo_id + '_' + request.resource.data.jugador_id;

      allow update: if esAdmin(resource.data.grupo_id) && mantieneGrupo();
      allow delete: if esAdmin(miembroId.split('_')[0]);
    }

    // ─── Partidos ───────────────────────────────────────────────────────────

    match /partidos/{partidoId} {
      allow read: if esMiembro(resource.data.grupo_id);
      allow create: if esAdmin(request.resource.data.grupo_id);

      // Los votos de cualquier jugador pueden avanzar la combinación o confirmar equipos.
      // Un partido 'jugado' (cerrado con resultado) no vuelve a otro estado.
      allow update: if mantieneGrupo()
        && (resource.data.estado != 'jugado' || request.resource.data.estado == 'jugado')
        && (esAdmin(resource.data.grupo_id)
            || (esMiembro(resource.data.grupo_id)
                && soloCambia(['estado', 'combinacion_actual'])
                && request.resource.data.estado != 'jugado'));

      // Votación MVP: cualquier miembro la cierra pasadas las 24 hs, o al completar
      // los votos (mvp_cerrado_por = su jugador, que tiene que haber votado)
      allow update: if mantieneGrupo()
        && esMiembro(resource.data.grupo_id)
        && soloCambia(['mvp_estado', 'mvp_cerrado_en', 'mvp_cerrado_por'])
        && resource.data.get('mvp_estado', null) == 'abierta'
        && request.resource.data.mvp_estado == 'cerrada'
        && request.resource.data.mvp_cerrado_en == request.time
        && (request.time >= resource.data.mvp_abierto_en + duration.value(24, 'h')
            || (esMiJugador(request.resource.data.mvp_cerrado_por)
                && exists(rutaVotoMvp(partidoId, request.resource.data.mvp_cerrado_por))));

      // Ya cerrada, quien la cerró guarda el resultado (una sola vez)
      allow update: if mantieneGrupo()
        && esMiembro(resource.data.grupo_id)
        && soloCambia(['mvp_resultados', 'mvp_ganador_jugador_id'])
        && resource.data.get('mvp_estado', null) == 'cerrada'
        && resource.data.get('mvp_resultados', null) == null
        && request.resource.data.mvp_resultados is list;

      allow delete: if esAdmin(resource.data.grupo_id);
    }

    match /participaciones/{participacionId} {
      allow read: if esMiembro(resource.data.grupo_id);

      allow create: if esMiembro(request.resource.data.grupo_id)
        && jugador(request.resource.data.jugador_id).grupo_id == request.resource.data.grupo_id
        && (esMiJugador(request.resource.data.jugador_id) || esAdmin(request.resource.data.grupo_id));

      allow update: if mantieneGrupo()
        && (esAdmin(resource.data.grupo_id)
            // Mi asistencia, mi lugar en la lista y mis votos
            || (esMiJugador(resource.data.jugador_id)
                && soloCambia(['confirmo_asistencia', 'votos_equipos', 'es_suplente', 'inscripto_en']))
            // Cuando un titular se baja, su navegador sube al primer suplente
            || (esMiembro(resource.data.grupo_id)
                && soloCambia(['es_suplente'])
                && resource.data.confirmo_asistencia == true
                && request.resource.data.es_suplente == false)
            // Al regenerar combinaciones cualquier miembro reinicia los votos de todos
            || (esMiembro(resource.data.grupo_id)
                && soloCambia(['votos_equipos'])
                && request.resource.data.votos_equipos.size() == 0)
            // Marca "ya voté al MVP", en el mismo batch que crea el voto
            || (esMiJugador(resource.data.jugador_id)
                && soloCambia(['voto_mvp'])
                && request.resource.data.voto_mvp == true
                && existsAfter(rutaVotoMvp(resource.data.partido_id, resource.data.jugador_id))));

      allow delete: if esAdmin(resource.data.grupo_id);
    }

    // Combinaciones de equipos (id = id del partido)
    match /equipo_partido/{partidoId} {
      allow read: if resource == null || esMiembro(resource.data.grupo_id);
      allow create: if esMiembro(request.resource.data.grupo_id);
      allow update: if esMiembro(resource.data.grupo_id) && mantieneGrupo();
      allow delete: if esAdmin(resource.data.grupo_id);
    }

    match /convocatoria_config/{grupoId} {
      allow read: if esMiembro(grupoId);
      allow write: if esAdmin(grupoId);
    }

    // id = {partido_id}_{votante_jugador_id}: como no se permite update,
    // cada jugador puede votar una sola vez por partido
    function votoMvpValido(v, votoId) {
      let partido = partidoDe(v.partido_id);
      return v.keys().hasOnly(['grupo_id', 'partido_id', 'votante_jugador_id', 'votado_jugador_id',
                               'votante_participacion_id', 'votado_participacion_id', 'creado_en'])
        && votoId == v.partido_id + '_' + v.votante_jugador_id
        && v.creado_en == request.time
        && v.votante_jugador_id != v.votado_jugador_id
        && esMiJugador(v.votante_jugador_id)
        && jugador(v.votante_jugador_id).grupo_id == v.grupo_id
        && partido.grupo_id == v.grupo_id
        && partido.get('mvp_estado', null) == 'abierta'
        && request.time < partido.mvp_abierto_en + duration.value(24, 'h')
        // Votante y votado tienen que haber jugado ese partido
        && jugoElPartido(v.votante_participacion_id, v.votante_jugador_id, v.partido_id)
        && jugoElPartido(v.votado_participacion_id, v.votado_jugador_id, v.partido_id);
    }

    match /votos_mvp/{votoId} {
      // Cada uno ve su voto; los de los demás, recién con la votación cerrada
      allow read: if esMiembro(resource.data.grupo_id)
        && (esMiJugador(resource.data.votante_jugador_id)
            || partidoDe(resource.data.partido_id).get('mvp_estado', null) == 'cerrada');
      allow create: if votoMvpValido(request.resource.data, votoId);
      allow update: if false;
      allow delete: if esAdmin(resource.data.grupo_id);
    }

    // ─── Notificaciones in-app ──────────────────────────────────────────────
    // destinatario_uid = null → para todos los miembros del grupo.
    // No hay backend: las crea el navegador de quien dispara el evento,
    // y estas reglas limitan quién puede crear cada tipo.

    function puedeLeerNotificacion(datos) {
      return logueado()
        && (datos.destinatario_uid == request.auth.uid
            || (datos.destinatario_uid == null && esMiembro(datos.grupo_id)));
    }

    match /notificaciones/{notificacionId} {
      allow read: if puedeLeerNotificacion(resource.data);

      allow create: if logueado()
        && request.resource.data.autor_uid == request.auth.uid
        && request.resource.data.creada_en == request.time
        && (request.resource.data.leida_por == [] || request.resource.data.leida_por == [request.auth.uid])
        && request.resource.data.tipo in [
             'solicitud_pendiente', 'solicitud_aprobada', 'solicitud_rechazada',
             'nueva_convocatoria', 'votacion_equipos', 'equipos_confirmados',
             'votacion_mvp', 'mvp_ganador', 'traidor', 'paso_a_titular', 'nuevo_titular'
           ]
        && esMiembro(request.resource.data.grupo_id)
        && (
          // El admin puede crear cualquier notificación de su grupo
          esAdmin(request.resource.data.grupo_id)
          // Un jugador dispara estas al votar, al bajarse o al cerrar la votación MVP
          || (request.resource.data.destinatario_uid == null
              && request.resource.data.tipo in ['equipos_confirmados', 'traidor', 'nuevo_titular', 'mvp_ganador'])
          // Al liberarse un lugar se avisa al suplente que sube (a su propia cuenta)
          || (request.resource.data.tipo == 'paso_a_titular'
              && jugador(request.resource.data.jugador_id).grupo_id == request.resource.data.grupo_id
              && request.resource.data.destinatario_uid
                   == jugador(request.resource.data.jugador_id).uid_firebase)
          // Quien se une con código avisa solo al admin
          || (request.resource.data.tipo == 'solicitud_pendiente'
              && request.resource.data.destinatario_uid
                   == get(rutaGrupo(request.resource.data.grupo_id)).data.admin_uid)
        );

      // Cada uno solo puede marcarla como leída para sí mismo
      allow update: if puedeLeerNotificacion(resource.data)
        && soloCambia(['leida_por'])
        && request.resource.data.leida_por.toSet()
             == resource.data.leida_por.toSet().union([request.auth.uid].toSet());

      allow delete: if false;
    }

    match /noticias/{noticiaId} {
      allow read: if logueado();
      allow write: if false;
    }

    // Todo lo demás (incluida la vieja colección solicitudes_acceso) queda bloqueado
  }
}
